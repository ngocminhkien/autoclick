{
  "manifest_version": 3,
  "name": "Auto Click Đa Điểm - Multi-Point Clicker",
  "version": "2.1.0",
  "description": "Tự động click đa điểm trên mọi trang web và cloud phone (CloudEmulator/Redfinger). Lưu điểm bằng phím tắt, chạy vòng lặp tùy chỉnh theo Giây/Phút/Giờ, ưu tiên kịch bản chống xung đột.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Auto Click Đa Điểm",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "toggle-autoclicker": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Bật / Ẩn thanh công cụ Auto Clicker"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_end",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.css",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
