<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llFloatingDock"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_dock"
    android:padding="6dp"
    android:elevation="8dp">

    <!-- Dock Header: Drag Handle & Script Selector -->
    <LinearLayout
        android:id="@+id/llDragHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☰"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:paddingStart="4dp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/tvCurrentScriptName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kịch bản 1"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="110dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnMinimizeDock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="_"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCloseDock"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="✕"
            android:textColor="@color/danger"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dock Buttons Row -->
    <LinearLayout
        android:id="@+id/llDockButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Play / Pause Button -->
        <TextView
            android:id="@+id/btnPlayPause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="▶️"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_circle_primary"
            android:layout_marginEnd="6dp" />

        <!-- Add Point (+) -->
        <TextView
            android:id="@+id/btnAddPoint"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="➕"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_badge"
            android:layout_marginEnd="5dp" />

        <!-- Remove Last Point (-) -->
        <TextView
            android:id="@+id/btnRemovePoint"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="➖"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_badge"
            android:layout_marginEnd="5dp" />

        <!-- Toggle Show/Hide Markers (Single Script point visibility) -->
        <TextView
            android:id="@+id/btnToggleMarkers"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="👁️"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_badge"
            android:layout_marginEnd="5dp" />

        <!-- Switch Script -->
        <TextView
            android:id="@+id/btnSwitchScript"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:text="📑"
            android:textSize="14sp"
            android:gravity="center"
            android:background="@drawable/bg_badge" />

    </LinearLayout>
</LinearLayout>
