<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="10dp"
    app:strokeWidth="1dp"
    app:strokeColor="#334155">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: Switch, Name, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchScriptEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

            <EditText
                android:id="@+id/etScriptName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Kịch bản 1"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@null"
                android:inputType="text" />

            <TextView
                android:id="@+id/tvRunCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 0 lượt"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:background="@drawable/bg_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnDeleteScript"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@null"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/danger" />
        </LinearLayout>

        <!-- Interval & Priority Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ Chờ: "
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etIntervalVal"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="10"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:inputType="number"
                android:background="@drawable/bg_badge"
                android:padding="4dp"
                android:gravity="center" />

            <Spinner
                android:id="@+id/spinnerIntervalUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp" />

            <Spinner
                android:id="@+id/spinnerPriority"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Timing Mode Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tính giờ: "
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinnerTimingMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvPointsSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 0 điểm"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
